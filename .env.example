# ── Reasoning ─────────────────────────────────────────────────────────────────
# Required. SERV Reasoning API key from https://console.openserv.ai/ (SERV_API_KEY also works).
OPENSERV_API_KEY=
# Optional. Any model ID from https://docs.openserv.ai/serv-reasoning/models
# SERV_MODEL=gpt-5.4-mini
# Optional. Cap completion tokens (default 2048) via max_completion_tokens. Prevents SERV HTTP 400 when strict json_schema over-allocates output budget.
# SERV_MAX_COMPLETION_TOKENS=2048

# ── Payments (KiteAI testnet only; never put mainnet keys here) ───────────────
# testnet | recorded | simulated. Default: testnet if a rail below is configured,
# recorded on Vercel, simulated otherwise.
# MELIT_PAYMENT_MODE=testnet

# $1.00 of price = this many pieUSD on testnet (default 0.01, so the $300 cap = 3 pieUSD).
# MELIT_TESTNET_SCALE=0.01

# Rail 1: Kite Passport sandbox via the kpass CLI.
# Local: run `npm run kite:setup` (30-day Passport session TTL for hackathon judges), set MELIT_KPASS=1, SELLER_BASE_URL, KPASS_SESSION_ID.
# Vercel: run `npm run kite:export-runtime` on your laptop, paste KPASS_RUNTIME_BUNDLE_B64 (Sensitive).
#         `npm run prebuild` downloads vendor/kpass-linux-amd64 on the build machine.
# MELIT_KPASS=1
# KPASS_SESSION_ID=
# KPASS_RUNTIME_BUNDLE_B64=
# Kite's staging backend currently serves sandbox mode (prod answers sandbox requests as live).
# KPASS_BASE_URL=https://passport.staging.gokite.ai
# Public URL serving this app, so Passport's backend can reach the mock seller's x402 checkout.
# SELLER_BASE_URL=https://your-melit.vercel.app
# Same value locally and on the deploy, so orders the local agent signs verify at the deployed checkout.
# MELIT_ORDER_SECRET=

# Rail 2 fallback: direct pieUSD transfer on KiteAI testnet (chain 2368).
# A THROWAWAY testnet-only private key. Fund it at https://faucet.gokite.ai (KITE for gas + test USDT).
# Rail 2 pays pieUSD gaslessly (EIP-3009 via the x402 facilitator) or, failing that, transfers test USDT (needs KITE gas).
# X402_FACILITATOR_URL=https://facilitator.pieverse.io/v2
# AGENT_PRIVATE_KEY=
# Testnet address that receives mock seller payments (also used as the x402 payTo).
# MOCK_SELLER_PAYTO=

# Write each real testnet receipt to data/recorded-receipts.json (local runs only),
# so the Vercel deploy can replay them labelled "recorded".
# MELIT_RECORD_RECEIPTS=1

# After the real rails, issue a receipt clearly labelled "Simulated" instead of failing
# (useful on a public deploy whose testnet wallet may run dry).
# MELIT_SIMULATED_FALLBACK=1

# ── Reppo track: external evaluator ───────────────────────────────────────────
# Optional. Reppo Eval Router API key (https://eval.reppo.xyz/api-key). When set, every
# purchase's synthetic negotiation transcript is sent to Reppo (taskType "action",
# 440 credits per completed evaluation) and the verdict feeds back into Melit's strategy.
# REPPO_API_KEY=
# REPPO_BASE_URL=https://eval.reppo.xyz/api/v1

# Optional. Secret for signing ledger entries and orders. Derived from OPENSERV_API_KEY when unset.
# MELIT_LEDGER_SECRET=

# ── Shared persistence (ledger, list, rate limits) ───────────────────────────
# Vercel KV or Upstash Redis REST credentials. Without them, Melit uses data/demo-sessions/
# on disk (local / vitest). On Vercel production, set KV_REST_API_URL + KV_REST_API_TOKEN.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
