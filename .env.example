# Required. SERV Reasoning API key from https://console.openserv.ai/
# (SERV_API_KEY is also accepted.) Never commit a real key.
OPENSERV_API_KEY=

# Optional. Any model ID from https://docs.openserv.ai/serv-reasoning/models
# SERV_MODEL=gpt-5.4-mini

# Optional. Secret for signing ledger entries. Derived from OPENSERV_API_KEY when unset.
# MELIT_LEDGER_SECRET=
